# ALDI Talk Credentials
ALDI_USER=your-aldi-username
ALDI_PASS=your-aldi-password
THRESHOLD_ALDI_MB=500

# Lidl Connect Credentials
LIDL_USER=your-lidl-username
LIDL_PASS=your-lidl-password
THRESHOLD_LIDL_MB=500

# Betriebsmodi
DRY_RUN=true
POLL_INTERVAL_SECONDS=3600
DB_PATH=aldi_watcher.db

# Hinweis: Für verschlsselte Credentials:
# 1. Erstelle .secret.key (automatisch beim ersten Start)
# 2. Verschlssle Credentials: python -c "from core.security import SecurityManager; s=SecurityManager(); print(s.encrypt('your-password'))"
# 3. Speichere als ALDI_PASS_ENC, LIDL_PASS_ENC in .env
