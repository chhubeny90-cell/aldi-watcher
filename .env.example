# ALDI Talk Credentials
ALDI_USER=your-aldi-username
ALDI_PASS=your-aldi-password
THRESHOLD_ALDI_MB=500

# ALDI Talk – Konto 2 (optional)
ALDI_2_USER=your-aldi-username-2
ALDI_2_PASS=your-aldi-password-2
ALDI_2_THRESHOLD_MB=500

# Lidl Connect Credentials
LIDL_USER=your-lidl-username
LIDL_PASS=your-lidl-password
THRESHOLD_LIDL_MB=500

# Lidl Connect – Konto 2 (optional)
LIDL_2_USER=your-lidl-username-2
LIDL_2_PASS=your-lidl-password-2
LIDL_2_THRESHOLD_MB=500

# Betriebsmodi
DRY_RUN=true
AUTO_BOOK_ENABLED=false
POLL_INTERVAL_SECONDS=3600
DB_PATH=aldi_watcher.db

# Hinweis: Für verschlüsselte Credentials:
# 1. Erstelle .secret.key (automatisch beim ersten Start)
# 2. Verschlüssele Credentials: python -c "from core.security import SecurityManager; s=SecurityManager(); print(s.encrypt('your-password'))"
# 3. Speichere als ALDI_PASS_ENC, LIDL_PASS_ENC in .env

# LIDL: available = refill when its verified free button is enabled (ALDI-style).
# needed = also require remaining MB <= THRESHOLD_LIDL_MB (not consumed MB).
LIDL_USE_API=false
LIDL_REFILL_MODE=available
LIDL_ACTIVE_TARIFF_SELECTOR=
LIDL_REFILL_OFFER_SELECTOR=
LIDL_REFILL_BUTTON_SELECTOR=
LIDL_REFILL_SUCCESS_SELECTOR=

# Multi-Account-Format: ALDI_1_*, ALDI_2_*, LIDL_1_*, LIDL_2_*
# Die Variablen werden in einem Block ab ALDI_1_USER / LIDL_1_USER automatisch erkannt.
# Das klassische ALDI_USER/LIDL_USER-Format bleibt kompatibel.
