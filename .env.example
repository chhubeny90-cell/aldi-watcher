# ALDI Talk Credentials
ALDI_USER=
# Optionaler abweichender Portal-Benutzername; ALDI_USER bleibt die SIM-Zuordnung.
ALDI_LOGIN_USER=
ALDI_PASS=
THRESHOLD_ALDI_MB=500

# Lidl Connect Credentials
LIDL_USER=
LIDL_PASS=
THRESHOLD_LIDL_MB=500

# Betriebsmodi
DRY_RUN=true
# watcher.py is monitoring-only and requires false. main.py also requires
# explicit true together with DRY_RUN=false before plugin booking is possible.
# Do not enable before provider live validation and reconciliation are verified.
AUTO_BOOK_ENABLED=false
POLL_INTERVAL_SECONDS=3600
DB_PATH=aldi_watcher.db

# Zugangsdaten nur privat eintragen, niemals committen oder ins Log schreiben.
# Diese Datei aktiviert keinen Dienst und keinen Login.
# Verschlüsselung (optional):
# python -m core.protect_config --key-file /privater/pfad/credentials.key
# Danach denselben absoluten Pfad als CREDENTIAL_KEY_FILE setzen.
# Der normale Start erzeugt KEINEN Schlüssel. Bestehende Schlüssel beibehalten.
# CREDENTIAL_KEY_FILE=/privater/pfad/credentials.key
# Credential-Schlüssel und ALDI_RECOVERY_KEY sind unterschiedliche Schlüssel.
# ALDI_RECOVERY_KEY niemals als Ersatz für eine bestehende Historie neu erzeugen.
# Kein ALDI_DRY_RUN/ALDI_RUN_MODE aus dem Word-Entwurf: verwendet werden die
# oben angegebenen Repository-Variablen DRY_RUN und POLL_INTERVAL_SECONDS.

# LIDL: available = refill when its verified free button is enabled (ALDI-style).
# needed = also require remaining MB <= THRESHOLD_LIDL_MB (not consumed MB).
LIDL_USE_API=false
LIDL_REFILL_MODE=available
# Capture these CSS selectors from a signed-in account; no guessed defaults.
# Active tariff: exact name only, no tariff list or marketing container.
# Offer: one specific 1-GB Unlimited refill including its explicit zero price.
# Button: scoped INSIDE that offer. Success: specific new booking confirmation.
LIDL_ACTIVE_TARIFF_SELECTOR=
LIDL_REFILL_OFFER_SELECTOR=
LIDL_REFILL_BUTTON_SELECTOR=
LIDL_REFILL_SUCCESS_SELECTOR=
