# ALDI Talk Credentials
ALDI_USER=+49 157 57172640
ALDI_PASS=your-aldi-passwort
THRESHOLD_ALDI_MB=500

# Lidl Connect Credentials
LIDL_USER=+49 163 2321869
LIDL_PASS=your-lidl-passwort
THRESHOLD_LIDL_MB=500

# Betriebsmodi
DRY_RUN=true
AUTO_BOOK_ENABLED=false
POLL_INTERVAL_SECONDS=3600
DB_PATH=aldi_watcher.db

# Hinweis: Für verschlüsselte Credentials:
# 1. .secret.key automatisch beim ersten Start erzeugen
# 2. Verschlüsseln:
#    python -c "from core.security import SecurityManager; s=SecurityManager(); print(s.encrypt('your-password'))"
# 3. Dann ALDI_PASS_ENC / LIDL_PASS_ENC statt Klartext verwenden

# LIDL: available = refill when its verified free button is enabled (ALDI-style).
# needed = also require remaining MB <= THRESHOLD_LIDL_MB (not consumed MB).
LIDL_USE_API=false
LIDL_REFILL_MODE=available

# Capture these CSS selectors from a signed-in account; no guessed defaults.
# Active tariff: exact name only, no tariff list or marketing container.
# Offer: one specific 1-GB Unlimited refill including its explicit zero price.
# Button: scoped INSIDE that offer. Success: specific new booking confirmation.
LIDL_ACTIVE_TARIFF_SELECTOR=
LIDL_REFILL_OFFER_SELECTOR=
LIDL_REFILL_BUTTON_SELECTOR=
LIDL_REFILL_SUCCESS_SELECTOR=
