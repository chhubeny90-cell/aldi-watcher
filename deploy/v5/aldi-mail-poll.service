[Unit]
Description=Optional ALDI Gmail-only event fallback
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/aldi-watcher/deploy/v5
ExecStart=/usr/bin/docker compose run --rm --no-deps --name aldi-lite-mail-poll lite python -m lite mailbox-poll --interval 60
ExecStop=/usr/bin/docker stop --time 120 aldi-lite-mail-poll
Restart=on-failure
RestartSec=60
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
