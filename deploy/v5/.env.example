# Explicit account-to-mailbox mapping; aliases contain no personal number.
ALDI_ACCOUNT_ALIAS=primary
ALDI_MAILBOX=
ALDI_USER=
ALDI_PASS=

# Safe default. Live requires DRY_RUN=false and AUTO_BOOK_ENABLED=true.
DRY_RUN=true
AUTO_BOOK_ENABLED=false
LITE_DB_PATH=/data/lite.sqlite
# Optional cooldown; zero allows genuine new exhaustion after a recent refill.
LITE_RECENT_SUCCESS_GUARD_SECONDS=0

# Gmail readonly OAuth credential, securely provisioned on this host.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Real Google Cloud resources; push audience is the exact public HTTPS URL.
GMAIL_PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
LITE_PUBLIC_DOMAIN=

# Populate only from the authenticated portal actually observed for this account.
ALDI_ACCOUNT_SELECTOR=
ALDI_TARIFF_SELECTOR=
ALDI_OFFER_SELECTOR=
ALDI_BUTTON_SELECTOR=
ALDI_SUCCESS_SELECTOR=
ALDI_PENDING_SELECTOR=
ALDI_PENDING_NONE_TEXT=
ALDI_EXPECTED_TARIFF=
